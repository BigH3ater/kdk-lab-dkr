     "slugs": [
      "high-box-squat"
     ],
     "steps": [
      {
       "slug": "high-box-squat",
       "title": "High Box Squat",
       "dose": "3 × 8 · RPE 6–7 · rest 60–90 s",
       "cues": [
        "Box, bench or chair high enough that your hips sit slightly above your knees.",
        "Sit down fully, then drive through the heels to stand."
       ]
      }
     ]
    },
    {
     "id": "pallof_press",
     "name": "Standing Pallof Press",
     "group": "strength_a",
     "kind": "r",
     "days": [
      "mon"
     ],
     "slugs": [
      "pallof-press"
     ],
     "steps": [
      {
       "slug": "pallof-press",
       "title": "Standing Pallof Press",
       "dose": "3 × 10 / side · rest 40–60 s",
       "cues": [
        "Stand side-on to the band anchor, handle at chest height.",
        "Press straight out, hold 2 seconds, bring it back to the chest.",
        "Do not let the torso twist toward the anchor."
       ]
      }
     ]
    },
    {
     "id": "wall_pushup",
     "name": "Wall or Incline Push-Up",
     "group": "strength_a",
     "kind": "r",
     "days": [
      "mon"
     ],
     "slugs": [
      "wall-pushup"
     ],
     "steps": [
      {
       "slug": "wall-pushup",
       "title": "Wall or Incline Push-Up",
       "dose": "3 × 10–12 · rest 60 s",
       "cues": [
        "Hands on a wall or a high counter.",
        "Keep the body in one straight line: no sagging hips, no arched lower back.",
        "Lower the chest toward the surface and push back up."
       ]
      }
     ]
    },
    {
     "id": "elevated_rdl",
     "name": "Elevated Romanian Deadlift",
     "group": "strength_b",
     "kind": "w",
