     ],
     "slugs": [
      "seated-band-row"
     ],
     "steps": [
      {
       "slug": "seated-band-row",
       "title": "Seated Band Row",
       "dose": "3 × 12 · rest 60 s",
       "cues": [
        "Sit tall on the floor or a stool, legs out, band around the feet.",
        "Pull the elbows back, squeezing the shoulder blades together.",
        "Do not let the lower back arch."
       ]
      }
     ]
    },
    {
     "id": "glute_bridge",
     "name": "Glute Bridge",
     "group": "strength_b",
     "kind": "r",
     "days": [
