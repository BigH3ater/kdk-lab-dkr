     ],
     "slugs": [
      "kneeling-hip-flexor"
     ],
     "steps": [
      {
       "slug": "kneeling-hip-flexor",
       "title": "Tall-Kneeling Hip Flexor Stretch",
       "dose": "30 s / side · 2–3× a day",
       "cues": [
        "Kneel on both knees on a cushion.",
        "Tuck the pelvis under and squeeze the glute on the side you stretch.",
        "Do not lunge forward; the stretch comes from the tuck alone."
       ]
      }
     ]
    },
