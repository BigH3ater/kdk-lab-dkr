      "thu"
     ],
     "slugs": [
      "elevated-rdl"
     ],
     "steps": [
      {
       "slug": "elevated-rdl",
       "title": "Elevated Romanian Deadlift",
       "dose": "3 × 8 · rest 90 s",
       "cues": [
        "Stand tall with dumbbells, a soft bend in the knees (never locked).",
        "Hinge at the hips and lower the weights only to just below the kneecaps.",
        "Keep the spine neutral; squeeze the glutes to stand back up."
       ]
      }
     ]
    },
    {
     "id": "seated_band_row",
     "name": "Seated Band Row",
     "group": "strength_b",
     "kind": "r",
     "days": [
