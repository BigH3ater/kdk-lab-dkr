     ],
     "slugs": [
      "seated-nerve-glide"
     ],
     "steps": [
      {
       "slug": "seated-nerve-glide",
       "title": "Seated Nerve Glide",
       "dose": "10–12 reps / leg · 2–3× a day",
       "cues": [
        "Sit tall at the edge of a chair with one leg straight out.",
        "Point the toes away as you look up; pull the toes back as you look down.",
        "Keep it smooth and slow; never push into pain or tingling."
       ]
      }
     ]
    },
