     ],
     "slugs": [
      "glute-bridge"
     ],
     "steps": [
      {
       "slug": "glute-bridge",
       "title": "Glute Bridge",
       "dose": "3 × 12 · hold 2 s at the top · rest 60 s",
       "cues": [
        "Lie on your back, knees bent, feet flat.",
        "Squeeze the glutes to lift the hips into a line from shoulders to knees.",
        "Do not over-arch the lower back at the top."
       ]
      }
     ]
    },
