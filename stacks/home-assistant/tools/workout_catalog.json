     ],
     "slugs": [
      "side-lying-rest"
     ],
     "steps": [
      {
       "slug": "side-lying-rest",
       "title": "Supported Side-Lying Rest",
       "dose": "2–3 min / side",
       "cues": [
            "Lie on your side at the edge of a firm bed, head on a pillow, hips stacked, lower leg straight.",
            "A helper holds the front and top of the hip; let the top leg hang freely off the edge.",
            "Breathe slowly for 2–3 minutes, then the other side."
