       "slug": "wall-slide",
       "title": "Supported Wall Slide",
       "dose": "2 × 8 · hold 5 s",
       "cues": [
        "Back against a smooth wall (a gym ball behind the lower back is optional).",
        "Slide down into a partial squat, no lower than 90 degrees.",
        "Hold 5 seconds while breathing, then slide back up."
       ]
      }
     ]
    },
