{
  "uid": "kdk-service-health",
  "title": "Service Health",
  "description": "Blackbox reachability, latency and TLS expiry for every probed endpoint. Same probes as the EndpointDown / SmartHomeEndpointDown / TLSCertExpiringSoon alerts.",
  "tags": [
    "blackbox",
    "services"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Probe set",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "blackbox-service,blackbox-http-app,blackbox-dns,blackbox-icmp",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Endpoints up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=~\"$job\"})",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Endpoints down",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(probe_success{job=~\"$job\"} == 0) or vector(0)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Soonest TLS expiry",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min((probe_ssl_earliest_cert_expiry - time()) / 86400)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Slowest probe (now)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(probe_duration_seconds{job=~\"$job\"})",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Availability (range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(avg_over_time(probe_success{job=~\"$job\"}[$__range]))",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Status by endpoint",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "probe_success{job=~\"$job\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 7,
      "title": "Endpoint detail",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "probe_success{job=~\"$job\"}",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "probe_http_status_code{job=~\"$job\"}",
          "instant": true,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "probe_duration_seconds{job=~\"$job\"}",
          "instant": true,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=~\"$job\"} - time()) / 86400",
          "instant": true,
          "format": "table",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "avg_over_time(probe_success{job=~\"$job\"}[$__range])",
          "instant": true,
          "format": "table",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "source": true,
              "host": true,
              "tier": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "HTTP",
              "Value #C": "Probe s",
              "Value #D": "TLS days",
              "Value #E": "Avail (range)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Up"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Probe s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TLS days"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avail (range)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Probe duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"$job\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "TLS certificate days left",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [],
  "id": null
}
