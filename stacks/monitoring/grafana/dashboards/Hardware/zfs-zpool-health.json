{
  "id": null,
  "uid": "zfs-zpool-health",
  "title": "ZFS Zpool Health",
  "description": "ZFS pool state, capacity, ARC and per-pool I/O for every node_exporter host that reports ZFS (kdk-hyp-01, kdk-nas-01).",
  "tags": [
    "zfs",
    "truenas",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "prometheus-ext",
          "value": "prometheus-ext"
        },
        "hide": 0,
        "label": "Prometheus datasource",
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": {
          "query": "label_values(node_zfs_zpool_state{job=\"node-external\"}, instance)",
          "refId": "zfs-instance"
        },
        "definition": "label_values(node_zfs_zpool_state{job=\"node-external\"}, instance)",
        "current": {
          "selected": true,
          "text": "10.1.3.5:9100",
          "value": "10.1.3.5:9100"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Pool Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "node_zfs_zpool_state{job=\"node-external\",instance=~\"$instance\"} == 1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [],
          "overrides": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "online": {
                        "text": "ONLINE",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*",
                      "result": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "zpool"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pool"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            },
            "indexByName": {
              "zpool": 0,
              "state": 1
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool Capacity Used %",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "100 * sum by (instance, pool) (label_replace(node_filesystem_size_bytes{job=\"node-external\",instance=~\"$instance\",fstype=\"zfs\"} - node_filesystem_avail_bytes{job=\"node-external\",instance=~\"$instance\",fstype=\"zfs\"}, \"pool\", \"$1\", \"device\", \"([^/]+).*\")) / (sum by (instance, pool) (label_replace(node_filesystem_size_bytes{job=\"node-external\",instance=~\"$instance\",fstype=\"zfs\"} - node_filesystem_avail_bytes{job=\"node-external\",instance=~\"$instance\",fstype=\"zfs\"}, \"pool\", \"$1\", \"device\", \"([^/]+).*\")) + max by (instance, pool) (label_replace(node_filesystem_avail_bytes{job=\"node-external\",instance=~\"$instance\",fstype=\"zfs\"}, \"pool\", \"$1\", \"device\", \"([^/]+).*\")))",
          "legendFormat": "{{instance}} {{pool}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 3,
      "title": "ARC Hit Ratio",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "100 * rate(node_zfs_arc_hits{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]) / (rate(node_zfs_arc_hits{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]) + rate(node_zfs_arc_misses{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} ARC hit ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "ARC Size",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "node_zfs_arc_size{job=\"node-external\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} ARC size",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "node_zfs_arc_c{job=\"node-external\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} ARC target (c)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "node_zfs_arc_c_max{job=\"node-external\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} ARC max (c_max)",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Per-Pool Throughput (read / -write)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "sum by (instance, zpool) (rate(node_zfs_zpool_dataset_nread{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{zpool}} read",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "-sum by (instance, zpool) (rate(node_zfs_zpool_dataset_nwritten{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{zpool}} write",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Per-Pool IOPS (read / -write)",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "sum by (instance, zpool) (rate(node_zfs_zpool_dataset_reads{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{zpool}} read",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "-sum by (instance, zpool) (rate(node_zfs_zpool_dataset_writes{job=\"node-external\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{zpool}} write",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
