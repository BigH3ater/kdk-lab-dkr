    {
      "id": 7,
      "title": "Runs per day by exit code",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (backup, code) (count_over_time({container=\"docker-event-watch\"} |~ \"event name=backup-(collect|offsite|verify)-(collect|offsite|verify)-1 action=die\" | regexp \"event name=backup-(?P<backup>[a-z]+)-(?:collect|offsite|verify)-1 action=die code=(?P<code>[0-9]+)\" [1d]))",
          "legendFormat": "{{backup}} exit {{code}}",
          "queryType": "range",
          "step": "1d",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "description": "One bar per job per day. Anything other than exit 0 is a failure.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* exit [1-9].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Run events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "{container=\"docker-event-watch\"} |~ \"event name=backup-\"",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Result lines (best effort)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{stack=~\"backup-.*\"} |~ \"BACKUP |rclone exit=| OK$|FAILED\"",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "description": "Alloy discovers running containers, so output from these short one-shot jobs is often missed. The run events above are the reliable record.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
