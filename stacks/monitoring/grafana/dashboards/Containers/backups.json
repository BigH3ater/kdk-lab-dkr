{
  "id": null,
  "uid": "kdk-backups",
  "title": "Backups",
  "description": "Nightly backup pipeline (backup-collect, backup-offsite, backup-verify): run results from docker-event-watch exit codes in Loki, plus whatever job output Alloy captured. Replaces the k3s CronJob dashboard.",
  "tags": [
    "backups",
    "loki"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Verify OK",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"docker-event-watch\"} |~ \"event name=backup-verify-verify-1 action=die code=0 \" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "description": "backup-verify runs that exited 0 (BACKUP OK, possibly with warnings). From docker-event-watch die events.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Verify failed",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"docker-event-watch\"} |~ \"event name=backup-verify-verify-1 action=die code=[1-9][0-9]* \" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "description": "backup-verify runs that exited non-zero: validation failed (this also pages via Pushover).",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
