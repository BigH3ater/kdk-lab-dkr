{
  "id": null,
  "uid": "kdk-stack-detail",
  "title": "Stack Detail",
  "description": "One compose stack: container CPU, memory against its limit, network, uptime and logs. Replaces the k3s-era Media, Immich, Home Assistant and Jellyfin dashboards.",
  "tags": [
    "cadvisor",
    "containers"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "stack",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ext"
        },
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",name!=\"\"}, stack)",
          "refId": "stack-var",
          "qryType": 1
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",name!=\"\"}, stack)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "media",
          "value": "media"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU by container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\",stack=\"$stack\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory by container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\",stack=\"$stack\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "sum by (name) (container_spec_memory_limit_bytes{job=\"cadvisor\",name!=\"\",stack=\"$stack\"} > 0 and container_spec_memory_limit_bytes{job=\"cadvisor\",name!=\"\",stack=\"$stack\"} < 1e15)",
          "legendFormat": "{{name}} limit",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Network (rx / -tx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",name!=\"\",stack=\"$stack\"}[$__rate_interval]))",
          "legendFormat": "{{name}} rx",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "-sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",name!=\"\",stack=\"$stack\"}[$__rate_interval]))",
          "legendFormat": "{{name}} tx",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Containers",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ext"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (host, stack, name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\",stack=\"$stack\"}[$__rate_interval]))",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "sum by (host, stack, name) (container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\",stack=\"$stack\"})",
          "instant": true,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        },
        {
          "expr": "min by (host, stack, name) (time() - container_start_time_seconds{job=\"cadvisor\",name!=\"\",stack=\"$stack\"})",
          "instant": true,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ext"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "CPU cores",
              "Value #B": "Memory",
              "Value #C": "Up for"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Up for"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU cores"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "Error-looking log lines",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time({job=\"docker\", stack=\"$stack\"} |~ \"(?i)(error|fatal|panic|exception|traceback)\" [$__auto]))",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-dkr01"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "expr": "{job=\"docker\", stack=\"$stack\"}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dkr01"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Media",
      "type": "link",
      "url": "/d/kdk-stack-detail?var-stack=media",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Immich",
      "type": "link",
      "url": "/d/kdk-stack-detail?var-stack=immich",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Home Assistant",
      "type": "link",
      "url": "/d/kdk-stack-detail?var-stack=home-assistant",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Jellyfin",
      "type": "link",
      "url": "/d/kdk-stack-detail?var-stack=jellyfin",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Containers Overview",
      "type": "link",
      "url": "/d/kdk-containers",
      "keepTime": true,
      "icon": "dashboard"
    }
  ]
}
