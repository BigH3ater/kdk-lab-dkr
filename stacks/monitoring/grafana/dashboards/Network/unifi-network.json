    {
      "id": 12,
      "title": "Device CPU & Memory Utilization",
      "description": "unpoller_device_cpu_utilization_ratio / unpoller_device_memory_utilization_ratio -- backs the UnifiDeviceHighCPU / UnifiDeviceHighMemory alerts (>0.9 for 10m).",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
