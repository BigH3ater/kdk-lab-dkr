    },
    {
      "id": 8,
      "title": "Top 10 Client Bandwidth",
      "description": "topk(10, unpoller_client_receive_rate_bytes + unpoller_client_transmit_rate_bytes) -- combined rx+tx, all clients (wired + wireless share identical label sets so the binary op joins cleanly).",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, unpoller_client_receive_rate_bytes + unpoller_client_transmit_rate_bytes)",
          "legendFormat": "{{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Active Client Anomalies",
      "description": "unpoller_client_anomalies -- UniFi anomaly bitmask per client, -1/0 = none observed. count(... > 0) or vector(0) so this reads a real 0 rather than Grafana's No Data when nothing is currently anomalous.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(unpoller_client_anomalies > 0) or vector(0)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
