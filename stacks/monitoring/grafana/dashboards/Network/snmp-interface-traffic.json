{
  "id": null,
  "uid": "snmp-if-traffic",
  "title": "SNMP Interface Traffic",
  "description": "UniFi network gear interface metrics via snmp_exporter's if_mib module -- see Homelab/K3s Services/K3s SNMP Exporter.md",
  "tags": [
    "snmp",
    "networking"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "prometheus-ext",
          "value": "prometheus-ext"
        },
        "hide": 0,
        "label": "Prometheus datasource",
        "regex": ""
      },
      {
        "name": "target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "query": "label_values(ifOperStatus, target)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "label": "Target"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Interface Traffic (in / -out)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "rate(ifHCInOctets{target=~\"$target\"}[$__rate_interval]) * 8",
          "legendFormat": "{{target}} {{ifDescr}} in",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "-rate(ifHCOutOctets{target=~\"$target\"}[$__rate_interval]) * 8",
          "legendFormat": "{{target}} {{ifDescr}} out",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Interface Errors (in / -out)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "rate(ifInErrors{target=~\"$target\"}[$__rate_interval])",
          "legendFormat": "{{target}} {{ifDescr}} in",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "-rate(ifOutErrors{target=~\"$target\"}[$__rate_interval])",
          "legendFormat": "{{target}} {{ifDescr}} out",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Interface Discards (in / -out)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "rate(ifInDiscards{target=~\"$target\"}[$__rate_interval])",
          "legendFormat": "{{target}} {{ifDescr}} in",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "-rate(ifOutDiscards{target=~\"$target\"}[$__rate_interval])",
          "legendFormat": "{{target}} {{ifDescr}} out",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Interface Status",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "ifOperStatus{target=~\"$target\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "color": "green"
                },
                "2": {
                  "text": "down",
                  "color": "red"
                },
                "3": {
                  "text": "testing",
                  "color": "yellow"
                }
              }
            }
          ],
          "overrides": []
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "ifIndex": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Interface Speed",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "ifHighSpeed{target=~\"$target\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Mbits"
              },
              {
                "id": "displayName",
                "value": "Speed"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "ifIndex": true
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "SNMP Scrape Health (exporter's own polling, not the target device)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "snmp_scrape_duration_seconds{target=~\"$target\"}",
          "legendFormat": "{{target}} total scrape",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "snmp_scrape_walk_duration_seconds{target=~\"$target\"}",
          "legendFormat": "{{target}} walk",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
