// Syslog receiver on kdk-log-01. syslog.kmkdp.com resolves to 10.1.20.21
// (stacks/dns-reconcile/reconcile.py EXTRA), so the rsyslog forwarders
// (`*.* @@syslog.kmkdp.com:514` on the Pis, hosts/_common/rsyslog.d/
// 90-kdk-loki.conf on the VMs) land here. Docker publishes host :514 (tcp+udp)
// to 1514 in this container, which runs as a non-root user. Parsed as RFC3164
// and pushed to the Loki next to it.

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
}

loki.source.syslog "in" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "tcp"
    syslog_format = "rfc3164"
    labels        = { job = "syslog" }
  }
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.default.receiver]
}
