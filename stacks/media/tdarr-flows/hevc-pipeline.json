        "code": "module.exports = async (args) => {\n  // 2b. Dolby Vision gate (2026-08-27). Any re-encode destroys the DV RPU\n  // (NVENC cannot carry it). Profile 8 has an HDR10 base layer and degrades\n  // gracefully to static HDR10 -- verified on a transcoded episode: PQ/\n  // BT.2020 + mastering-display side data intact. Profiles 5 and 7 do NOT:\n  // profile 5 keeps its color math in the RPU alone, and its stripped\n  // output probes with NO color metadata at all (measured on 5 damaged\n  // files, 2026-08-27) -- washed-out/wrong color everywhere. Output 1 =\n  // safe to continue; output 2 = pure/dual-layer DV, hold for review.\n  const streams = (args.inputFileObj.ffProbeData || {}).streams || [];\n  let dvProfile = null;\n  for (const s of streams) {\n    if (s.codec_type !== 'video') continue;\n    for (const sd of (s.side_data_list || [])) {\n      const t = String(sd.side_data_type || '');\n      if (t.includes('DOVI configuration')) {\n        dvProfile = sd.dv_profile;\n      }\n    }\n  }\n  if (dvProfile === null) {\n    args.jobLog('DV gate: no Dolby Vision side data, continue');\n    return { outputFileObj: args.inputFileObj, outputNumber: 1, variables: args.variables };\n  }\n  if (dvProfile === 5 || dvProfile === 7) {\n    args.jobLog(`DV gate: profile ${dvProfile} (no usable HDR10 fallback after RPU loss) -- hold for review`);\n    return { outputFileObj: args.inputFileObj, outputNumber: 2, variables: args.variables };\n  }\n  args.jobLog(`DV gate: profile ${dvProfile} with HDR10 base layer -- continue, accepting DV enhancement-layer loss`);\n  return { outputFileObj: args.inputFileObj, outputNumber: 1, variables: args.variables };\n};"
      }
    },
