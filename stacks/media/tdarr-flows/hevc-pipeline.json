    {
      "name": "3b. DEE dispatch: lossless eng audio -> DD+ (Atmos-aware)",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "id": "dee1",
      "position": {
        "x": 520,
        "y": 400
      },
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  // \u00a77.4b DEE dispatch: replace the lossless English audio track with DD+\n  // (Atmos-aware) via the Windows DEE VM. When the wrapper is unreachable\n  // (token unset, busy, error) fall back to a NATIVE ffmpeg E-AC3 encode so\n  // DD+ is still guaranteed and the lossless->DD+ size win still lands --\n  // only a native-encode failure ends in true passthrough (output 2).\n  // Output 1 = converted (or nothing to convert); output 2 = could not\n  // convert -> continue with original audio.\n  const { execFileSync } = require('child_process');\n  const http = require('http');\n  const fs = require('fs');\n  const path = require('path');\n\n  const EXCHANGE = '/data/dee-exchange';\n  const WRAPPER = { host: '10.1.1.130', port: 8484 };\n  const TOKEN = process.env.DEE_WRAPPER_TOKEN || '';\n  const log = (m) => args.jobLog(`[dee] ${m}\\n`);\n\n  const src = args.inputFileObj._id;\n  const streams = (args.inputFileObj.ffProbeData || {}).streams || [];\n  const audio = streams.filter((s) => s.codec_type === 'audio');\n\n  const isLossless = (s) => {\n    const c = (s.codec_name || '').toLowerCase();\n    const prof = (s.profile || '').toLowerCase();\n    return c === 'truehd' || c === 'mlp' || c === 'flac' || c.startsWith('pcm')\n      || (c === 'dts' && prof.includes('dts-hd ma'));\n  };\n  const langOk = (s) => {\n    const l = ((s.tags || {}).language || '').toLowerCase();\n    return l === '' || l === 'eng' || l === 'und';\n  };\n\n  const idx = audio.findIndex((s) => isLossless(s) && langOk(s));\n  if (idx === -1) {\n    log('no lossless English audio track; nothing to convert');\n    return { outputFileObj: args.inputFileObj, outputNumber: 1, variables: args.variables };\n  }\n\n  const track = audio[idx];\n  const atmos = ((track.profile || '').toLowerCase().includes('atmos'));\n  const fmt = atmos ? 'atmos' : 'ddp';\n  const base = path.basename(src, path.extname(src)).replace(/[^a-zA-Z0-9._-]/g, '_').slice(0, 120);\n\n  // Sensible E-AC3 (DD+) bitrate by channel count: 256k stereo, 640k 5.1,\n  // 768k 7.1+ -- standard DD+ rates (Netflix uses 640k 5.1 / 768k Atmos).\n  const eac3Bitrate = (ch) => {\n    if (!ch || ch <= 2) return '256k';\n    if (ch <= 6) return '640k';\n    return '768k';\n  };\n  const nativeEac3 = () => {\n    const br = eac3Bitrate(track.channels);\n    const outPath = path.join(__dirname, `${base}.eac3.mkv`);\n    log(`native ffmpeg fallback: a:${idx} (${track.codec_name}, ${track.channels || '?'}ch) -> E-AC3 ${br}`);\n    execFileSync(args.ffmpegPath || 'tdarr-ffmpeg', [\n      '-y', '-i', src,\n      '-map', '0:v', '-map', `0:a:${idx}`, '-map', '0:s?', '-map_chapters', '0',\n      '-c', 'copy', '-c:a:0', 'eac3', '-b:a:0', br,\n      '-metadata:s:a:0', 'language=eng',\n      '-disposition:a:0', 'default',\n      outPath,\n    ], { stdio: 'pipe' });\n    return outPath;\n  };\n  const nativeFallback = (why) => {\n    log(`${why}; using native ffmpeg E-AC3 fallback`);\n    try {\n      const outPath = nativeEac3();\n      log(`native E-AC3 done; continuing with ${path.basename(outPath)}`);\n      return { outputFileObj: { _id: outPath }, outputNumber: 1, variables: args.variables };\n    } catch (e) {\n      log(`native E-AC3 fallback failed (${String(e).slice(0, 200)}); passthrough`);\n      return { outputFileObj: args.inputFileObj, outputNumber: 2, variables: args.variables };\n    }\n  };\n\n  if (!TOKEN) {\n    return nativeFallback('DEE_WRAPPER_TOKEN not set (secret not synced yet)');\n  }\n\n  const inboundName = `${base}.tdarr.mkv`;\n  const inboundPath = path.join(EXCHANGE, 'inbound', inboundName);\n  const cleanup = (p) => { try { fs.unlinkSync(p); } catch (e) { /* best effort */ } };\n\n  try {\n    log(`extracting audio stream a:${idx} (${track.codec_name}${atmos ? ' Atmos' : ''}) -> ${inboundName}`);\n    execFileSync(args.ffmpegPath || 'tdarr-ffmpeg', [\n      '-y', '-i', src, '-map', `0:a:${idx}`, '-c', 'copy', inboundPath,\n    ], { stdio: 'pipe' });\n\n    const body = JSON.stringify({ filename: inboundName, format: fmt });\n    const encodeOnce = () => new Promise((resolve, reject) => {\n      const req = http.request({\n        host: WRAPPER.host,\n        port: WRAPPER.port,\n        path: '/encode',\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Content-Length': Buffer.byteLength(body),\n          Authorization: `Bearer ${TOKEN}`,\n        },\n        timeout: 7800 * 1000, // socket timeout must EXCEED the wrapper's per-encode budget (DEE_WRAPPER_TIMEOUT_SECONDS, default 7200s) or a long DEE encode is abandoned mid-flight and wrongly falls back\n      }, (res) => {\n        let data = '';\n        res.on('data', (c) => { data += c; });\n        res.on('end', () => resolve({ status: res.statusCode, data }));\n      });\n      req.on('timeout', () => { req.destroy(new Error('wrapper request timed out')); });\n      req.on('error', reject);\n      req.write(body);\n      req.end();\n    });\n\n    let resp = null;\n    for (let attempt = 1; attempt <= 5; attempt += 1) {\n      // eslint-disable-next-line no-await-in-loop\n      resp = await encodeOnce();\n      if (resp.status !== 503) break;\n      log(`encoder busy (503), attempt ${attempt}/5; waiting 60s`);\n      // eslint-disable-next-line no-await-in-loop\n      await new Promise((r) => { setTimeout(r, 60 * 1000); });\n    }\n    if (resp.status !== 200) throw new Error(`wrapper returned ${resp.status}: ${resp.data.slice(0, 300)}`);\n\n    const outName = JSON.parse(resp.data).output_filename;\n    const ec3 = path.join(EXCHANGE, 'outbound', outName);\n    if (!fs.existsSync(ec3)) throw new Error(`wrapper reported ok but ${outName} not in outbound/`);\n\n    const outPath = path.join(__dirname, `${base}.dee.mkv`);\n    log(`remuxing DD+${atmos ? ' Atmos' : ''} track back (-c copy)`);\n    execFileSync(args.ffmpegPath || 'tdarr-ffmpeg', [\n      '-y', '-i', src, '-i', ec3,\n      '-map', '0:v', '-map', '1:a:0', '-map', '0:s?', '-map_chapters', '0',\n      '-c', 'copy',\n      '-metadata:s:a:0', 'language=eng',\n      '-disposition:a:0', 'default',\n      outPath,\n    ], { stdio: 'pipe' });\n\n    cleanup(inboundPath);\n    cleanup(ec3);\n    log(`done: audio replaced with ${fmt}; continuing with ${path.basename(outPath)}`);\n    return { outputFileObj: { _id: outPath }, outputNumber: 1, variables: args.variables };\n  } catch (err) {\n    cleanup(inboundPath);\n    return nativeFallback(`DEE branch failed (${String(err).slice(0, 300)})`);\n  }\n};\n"
      }
    },
    {
