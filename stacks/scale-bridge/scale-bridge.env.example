# EXAMPLE ONLY: made-up values. The real file is host-managed on kdk-dkr-02 at
# /opt/kdk-lab/scale-bridge/scale-bridge.env (root:root 600), never in git: the
# weight bands are health data. Runbook: docs/runbooks/scale-bridge.md.
#
# People: one JSON list on ONE line, in single quotes. Bands are inclusive, in
# pounds (min_lb/max_lb); min_kg/max_kg is still accepted instead, one pair per
# person, never both. A weight in no band or in two bands is logged and written
# nowhere. token_env names the variable in secrets.env that holds that person's
# wger API key.
SCALE_BRIDGE_PEOPLE='[{"name":"person-a","min_lb":1.0,"max_lb":2.0,"token_env":"WGER_API_KEY_PERSON_A"},{"name":"person-b","min_lb":3.0,"max_lb":4.0,"token_env":"WGER_API_KEY_PERSON_B"}]'
#
# Optional: only talk to this scale (its address is on the scale's device
# screen / the capture note in the vault). Empty = any device named "Body Pod 2".
SCALE_ADDRESS=
#
# Optional relay mode (untested on hardware): ESPHome Bluetooth proxies by IP,
# comma-separated, each optionally `=ENV_NAME` naming the variable in secrets.env
# that holds its API noise key. Empty = use the board's own Bluetooth adapter.
SCALE_BRIDGE_ESPHOME_PROXIES=
