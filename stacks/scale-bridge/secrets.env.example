# EXAMPLE ONLY: variable names, no values. The real file is host-managed on
# kdk-dkr-02 at /opt/kdk-lab/scale-bridge/secrets.env (root:root 600), written from
# 1Password in the runbook step (docs/runbooks/scale-bridge.md), never by hand.
# One line per person in SCALE_BRIDGE_PEOPLE (its token_env names these):
WGER_API_KEY_JMACK=
WGER_API_KEY_RACH=
# Relay mode, one per proxy named in SCALE_BRIDGE_ESPHOME_PROXIES: the API
# encryption (noise) key of the scale-relay board, from the 1Password item
# scale-relay-esphome, field credential. Named but empty = config_invalid.
SCALE_RELAY_NOISE_KEY=
# Body-composition engine, from the 1Password item lefu-engine-secret (runbook
# step 2b). Optional: without it the engine switches itself off.
LEFU_SECRET_8=
