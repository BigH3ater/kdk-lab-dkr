[Unit]
Description=tankz3/insta360-flat over storage net (read-write, finished Insta360 stills from insta360-flat)
After=network-online.target
[Mount]
What=172.16.30.2:/mnt/tankz3/insta360-flat
Where=/mnt/insta360-flat
Type=nfs
Options=nfsvers=4.1,noatime,_netdev
[Install]
WantedBy=multi-user.target
