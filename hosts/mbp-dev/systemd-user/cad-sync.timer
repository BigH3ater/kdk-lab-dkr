# Laptop mbp-dev, user timer: cad-sync every 15 min while jmack is logged
# in; Persistent catches up a slot missed while asleep. Install:
# ~/.config/systemd/user/ (0644), then `systemctl --user enable --now cad-sync.timer`.
# docs/runbooks/cad-library.md
[Unit]
Description=Push ~/cad to kdk-nas-01 every 15 min
[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60
[Install]
WantedBy=timers.target
