# Laptop mbp-dev, system timer: laptop-backup daily at 12:30 local (the
# laptop sleeps at night); Persistent catches up a slot missed while asleep or
# off. Install: /etc/systemd/system/ (root 0644), then
# `systemctl enable --now laptop-backup.timer`. docs/runbooks/laptop-backup.md
[Unit]
Description=restic backup of the laptop daily at 12:30
[Timer]
OnCalendar=*-*-* 12:30:00
Persistent=true
RandomizedDelaySec=10m
[Install]
WantedBy=timers.target
