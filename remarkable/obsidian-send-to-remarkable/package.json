{
  "name": "obsidian-send-to-remarkable",
  "version": "0.1.0",
  "description": "Send an Obsidian note, folder, or the whole vault to the reMarkable via a vault-synced request queue.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "remarkable"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.19.43",
    "builtin-modules": "3.3.0",
    "esbuild": "0.25.12",
    "obsidian": "1.7.2",
    "tslib": "2.6.3",
    "typescript": "5.4.5"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
