{
  "name": "Kodiak Grid margin",
  "author": "kdk-lab",
  "templateVersion": "1.0.0",
  "formatVersion": 1,
  "categories": [
    "Grids",
    "Planners"
  ],
  "orientation": "portrait",
  "constants": [
    {
      "gridSize": 78.3
    },
    {
      "leftX": "templateWidth / 2 - templateHeight / 2"
    },
    {
      "marginX": "templateWidth / 2 - templateHeight / 2 + 156.6"
    }
  ],
  "items": [
    {
      "id": "hlines",
      "type": "group",
      "boundingBox": {
        "x": "leftX",
        "y": 0,
        "width": "templateHeight",
        "height": "gridSize"
      },
      "repeat": {
        "rows": "infinite",
        "columns": "right"
      },
      "children": [
        {
          "type": "path",
          "strokeWidth": 1,
          "strokeColor": "#BEBEBE",
          "data": [
            "M",
            0,
            0,
            "L",
            "parentWidth",
            0
          ]
        }
      ]
    },
    {
      "id": "vlines",
      "type": "group",
      "boundingBox": {
        "x": "leftX",
        "y": 0,
        "width": "gridSize",
        "height": "templateHeight"
      },
      "repeat": {
        "rows": "infinite",
        "columns": "right"
      },
      "children": [
        {
          "type": "path",
          "strokeWidth": 1,
          "strokeColor": "#BEBEBE",
          "data": [
            "M",
            0,
            0,
            "L",
            0,
            "parentHeight"
          ]
        }
      ]
    },
    {
      "type": "path",
      "strokeWidth": 3,
      "strokeColor": "#C0392B",
      "data": [
        "M",
        "marginX",
        0,
        "L",
        "marginX",
        "templateHeight"
      ]
    }
  ]
}